---
import Layout from "../layouts/Layout.astro";
import ProductoCard from "../components/ProductoCard.astro";

interface Producto {
  id: number;
  title: string;
  price: number;
  category: string;
  rating: number;
  thumbnail: string;
}

let productos: Producto[] = [];
let mensajeError = "";

try {
  const respuesta = await fetch("https://dummyjson.com/products?limit=12");
  if (!respuesta.ok) {
    throw new Error(`Error HTTP: ${respuesta.status}`);
  }
  const datos = await respuesta.json();
  productos = datos.products ?? [];
} catch (error) {
  console.error("Error al consultar la API:", error);
  mensajeError = "No fue posible cargar los productos.";
}
---

<Layout title="Catálogo de productos">
  <main class="catalogo-page">
    <header class="catalogo-hero">
      <div class="hero-badges">
        <span class="badge badge-soft">✨ Nuevo</span>
        <span class="badge badge-contrast">Top picks</span>
      </div>

      <div class="hero-copy">
        <p class="eyebrow">Colección premium</p>
        <h1>Catálogo de Productos</h1>
        <p class="subtitle">
          Explora artículos destacados, tendencias y ofertas seleccionadas para
          cada estilo.
        </p>

        <div class="hero-actions">
          <button class="cta cta-primary" type="button" data-action="scroll">
            Ver colección
          </button>
          <button class="cta cta-secondary" type="button" data-action="clear">
            Mostrar todo
          </button>
        </div>
      </div>

      <div class="search-container" aria-label="Buscar producto">
        <label for="buscador" class="sr-only">Buscar producto</label>
        <div class="search-input-wrap">
          <span class="search-icon" aria-hidden="true">⌕</span>
          <input
            id="buscador"
            type="search"
            placeholder="Buscar productos..."
            autocomplete="off"
          />
        </div>
      </div>

      <div class="hero-stats" aria-label="Resumen del catálogo">
        <div class="stat-card">
          <strong>1200+</strong>
          <span>Productos</span>
        </div>
        <div class="stat-card">
          <strong>4.8/5</strong>
          <span>Valoración</span>
        </div>
        <div class="stat-card">
          <strong>24h</strong>
          <span>Entrega</span>
        </div>
      </div>
    </header>

    <aside class="cart-panel" aria-labelledby="cart-title">
      <div class="cart-heading">
        <div>
          <p class="cart-eyebrow">Tu selección</p>
          <h2 id="cart-title">Carrito <span id="cart-count" class="cart-count">0</span></h2>
        </div>
      </div>
      <p id="cart-empty" class="cart-empty">Aún no has añadido productos.</p>
      <ul id="cart-items" class="cart-items" aria-live="polite"></ul>
      <div class="cart-total">
        <span>Total</span>
        <strong id="cart-total">$0.00</strong>
      </div>
    </aside>

    {mensajeError && <p role="alert" class="alert-error">{mensajeError}</p>}

    <section id="catalog-grid" class="grid-productos" aria-label="Productos disponibles">
      {
        productos.length > 0 ? (
          productos.map((producto) => (
            <ProductoCard
              id={producto.id}
              title={producto.title}
              price={producto.price}
              category={producto.category}
              rating={producto.rating}
              thumbnail={producto.thumbnail}
            />
          ))
        ) : (
          !mensajeError && <p class="no-results">No hay productos disponibles.</p>
        )
      }
    </section>
  </main>
</Layout>

<script>
  const buscador = document.querySelector<HTMLInputElement>("#buscador");
  const tarjetas = document.querySelectorAll<HTMLElement>(".producto");

  const botonVerColeccion = document.querySelector<HTMLButtonElement>("[data-action='scroll']");
  const botonMostrarTodo = document.querySelector<HTMLButtonElement>("[data-action='clear']");
  const carritoLista = document.querySelector<HTMLUListElement>("#cart-items");
  const carritoVacio = document.querySelector<HTMLParagraphElement>("#cart-empty");
  const carritoCount = document.querySelector<HTMLElement>("#cart-count");
  const carritoTotal = document.querySelector<HTMLElement>("#cart-total");
  const carrito = new Map<number, { title: string; price: number; quantity: number }>();

  const actualizarCarrito = () => {
    if (!carritoLista || !carritoVacio || !carritoCount || !carritoTotal) return;

    carritoLista.replaceChildren();
    let cantidadTotal = 0;
    let precioTotal = 0;

    carrito.forEach((producto, id) => {
      cantidadTotal += producto.quantity;
      precioTotal += producto.price * producto.quantity;

      const item = document.createElement("li");
      item.className = "cart-item";

      const nombre = document.createElement("span");
      nombre.className = "cart-item-title";
      nombre.textContent = producto.title;

      const controles = document.createElement("div");
      controles.className = "cart-item-controls";

      const botonRestar = document.createElement("button");
      botonRestar.type = "button";
      botonRestar.className = "quantity-button";
      botonRestar.dataset.cartAction = "decrease";
      botonRestar.dataset.productId = String(id);
      botonRestar.setAttribute("aria-label", `Quitar una unidad de ${producto.title}`);
      botonRestar.textContent = "−";

      const cantidad = document.createElement("span");
      cantidad.className = "cart-item-quantity";
      cantidad.textContent = String(producto.quantity);

      const botonSumar = document.createElement("button");
      botonSumar.type = "button";
      botonSumar.className = "quantity-button";
      botonSumar.dataset.cartAction = "increase";
      botonSumar.dataset.productId = String(id);
      botonSumar.setAttribute("aria-label", `Añadir una unidad de ${producto.title}`);
      botonSumar.textContent = "+";

      controles.append(botonRestar, cantidad, botonSumar);

      const subtotal = document.createElement("span");
      subtotal.className = "cart-item-subtotal";
      subtotal.textContent = `$${(producto.price * producto.quantity).toFixed(2)}`;

      item.append(nombre, controles, subtotal);
      carritoLista.append(item);
    });

    carritoCount.textContent = String(cantidadTotal);
    carritoCount.setAttribute("aria-label", `${cantidadTotal} productos en el carrito`);
    carritoTotal.textContent = `$${precioTotal.toFixed(2)}`;
    carritoVacio.hidden = carrito.size > 0;
  };

  document.querySelector<HTMLElement>("#catalog-grid")?.addEventListener("click", (event) => {
    const boton = (event.target as HTMLElement).closest<HTMLButtonElement>("[data-add-to-cart]");
    const tarjeta = boton?.closest<HTMLElement>(".producto");
    if (!boton || !tarjeta) return;

    const id = Number(tarjeta.dataset.productId);
    const price = Number(tarjeta.dataset.price);
    const title = tarjeta.dataset.productTitle ?? "Producto";
    const producto = carrito.get(id);

    if (producto) {
      producto.quantity += 1;
    } else {
      carrito.set(id, { title, price, quantity: 1 });
    }

    actualizarCarrito();
  });

  carritoLista?.addEventListener("click", (event) => {
    const boton = (event.target as HTMLElement).closest<HTMLButtonElement>("[data-cart-action]");
    if (!boton) return;

    const id = Number(boton.dataset.productId);
    const producto = carrito.get(id);
    if (!producto) return;

    if (boton.dataset.cartAction === "increase") {
      producto.quantity += 1;
    } else if (boton.dataset.cartAction === "decrease") {
      if (producto.quantity === 1) {
        carrito.delete(id);
      } else {
        producto.quantity -= 1;
      }
    }

    actualizarCarrito();
  });

  if (buscador) {
    buscador.addEventListener("input", () => {
      const termino = buscador.value.toLowerCase().trim();

      tarjetas.forEach((tarjeta) => {
        const titulo = tarjeta.dataset.title ?? "";

        if (titulo.includes(termino)) {
          tarjeta.removeAttribute("hidden");
        } else {
          tarjeta.setAttribute("hidden", "");
        }
      });
    });
  }

  if (botonVerColeccion) {
    botonVerColeccion.addEventListener("click", () => {
      const catalogGrid = document.getElementById("catalog-grid");
      catalogGrid?.scrollIntoView({ behavior: "smooth", block: "start" });
      buscador?.focus();
    });
  }

  if (botonMostrarTodo) {
    botonMostrarTodo.addEventListener("click", () => {
      if (!buscador) return;
      buscador.value = "";
      buscador.dispatchEvent(new Event("input"));
      buscador.focus();
    });
  }

  actualizarCarrito();
</script>
